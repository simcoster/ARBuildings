# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data for ignored folders
!/[Aa]ssets/**/*.meta

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.DotSettings.user

# Secrets — contains Google Cloud API keys. Copy the .template and fill in your own.
/ProjectSettings/ARCoreExtensionsProjectSettings.json
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Unity build byproducts (large, regenerated every build)
/.utmp/
/*_BurstDebugInformation_DoNotShip/
/*_BackUpThisFolder_ButDontShipItWithYourGame/

# Source art: originals kept out of the build and out of git
/ModelSource/
/tools/encoder_bench/android

# Generated per build by BuildStampProcessor — changes on every build, never worth a diff
/Assets/Resources/BuildStamp.txt
/Assets/Resources/BuildStamp.txt.meta

# Unity scratch: recovery scraps, generated solution, and EDM leftovers
/Assets/_Recovery/
/Assets/_Recovery.meta
/*.slnx
*.json_old

# Claude Code local machine settings (skills under .claude/skills ARE tracked)
/.claude/settings.local.json

# AR Foundation XR Simulation scratch copies
/Assets/XR/Temp/
/Assets/XR/Temp.meta
